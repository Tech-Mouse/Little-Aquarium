    <ui:VisualElement name="Background" class="hover-on" style="flex-grow: 1; justify-content: center; background-color: rgba(255, 255, 255, 0.439); margin-top: 0; margin-right: 0; margin-left: 0; margin-bottom: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; display: none; aspect-ratio: 1.5;">
