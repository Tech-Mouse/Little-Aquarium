<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; width: 100%; height: 100%;">
        <ui:VisualElement name="Background" style="flex-grow: 1; background-color: rgba(234, 202, 143, 0.796); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; width: 100%; height: 100%; flex-wrap: wrap;">
            <ui:VisualElement name="Header" style="flex-grow: 0; width: 100%; height: 10%; justify-content: center; align-items: center; flex-shrink: 0; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; flex-wrap: wrap; margin-bottom: 10px;">
                <ui:Label text="Welcome to your Little Aquarium!" emoji-fallback-support="true" style="font-size: 40px; flex-wrap: wrap; white-space: pre-wrap;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Text" style="flex-grow: 1; flex-shrink: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; width: 100%; flex-wrap: wrap;">
                <ui:Label text="Buy some fish, feed them, pet them, and enjoy their presence!&#10;&#10;If you keep them happy, they&apos;ll generate more money.&#10;&#10;If you feed them, their health will be pristine." name="TextLabel" style="font-size: 30px; flex-wrap: wrap; white-space: pre-wrap;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Appendix" style="flex-grow: 0; align-items: center; flex-shrink: 0; height: 20%; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; width: 100%; justify-content: center; background-size: 100% 20%; flex-wrap: wrap;">
                <ui:Button text="Close" emoji-fallback-support="true" name="Close" style="font-size: 40px; background-color: rgb(255, 235, 219); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; white-space: pre-wrap; cursor: url(&quot;project://database/Assets/NativeCursor/Cursors/Windows/aero_link.cur?fileID=6778831284786772486&amp;guid=7782c1ba61d9b05428bee43be845a54d&amp;type=3#cursor_1_texture&quot;);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
